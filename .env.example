# =========================================================================== #
#  OVH Dynamic DNS updater - configuration
#  Copy this file to ".env" and fill in your own values.
# =========================================================================== #

# --- OVH API endpoint ------------------------------------------------------- #
# ovh-eu        -> OVH Europe (default)
# ovh-ca        -> OVH Canada
# ovh-us        -> OVH US
# kimsufi-eu / soyoustart-eu ... see the OVH documentation for other values.
OVH_ENDPOINT=ovh-eu

# --- OVH API credentials ---------------------------------------------------- #
# OVH requires THREE tokens (not a single "API key"). Generate them at:
#   https://www.ovh.com/auth/api/createToken
# Grant these rights on your zone (replace mondomaine.fr with your zone):
#   GET    /domain/zone/mondomaine.fr/*
#   PUT    /domain/zone/mondomaine.fr/*
#   POST   /domain/zone/mondomaine.fr/*
OVH_APPLICATION_KEY=your_application_key
OVH_APPLICATION_SECRET=your_application_secret
OVH_CONSUMER_KEY=your_consumer_key

# --- DNS target ------------------------------------------------------------- #
# The DNS zone (the domain managed by OVH).
DNS_ZONE=mondomaine.fr

# The fully qualified host whose A record must be checked/updated.
# It MUST belong to DNS_ZONE (e.g. ext.mondomaine.fr, or mondomaine.fr for the apex).
RECORD_FQDN=ext.mondomaine.fr

# --- Optional settings ------------------------------------------------------ #
# TTL used only when the A record has to be created for the first time.
RECORD_TTL=60

# Create the A record automatically if it does not exist yet (true/false).
CREATE_IF_MISSING=true

# Comma-separated list of services returning the public IPv4 as plain text.
# Leave commented to use the built-in defaults.
# IP_LOOKUP_URLS=https://api.ipify.org,https://ipv4.icanhazip.com,https://ifconfig.me/ip

# Loop mode: number of seconds between checks.
# 0 (default) = one-shot: run once at container start, then exit.
# >0          = keep the container running and re-check at this interval.
RUN_INTERVAL=0

# Log verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
